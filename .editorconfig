# Checked by editorconfig-checker in CI (every tracked file); shfmt also reads the shell settings.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# shfmt (the shell scripts and the Git hook): simplify the code, indent the case branches, put a binary operator
# at the start of a continued line, and write a space after a redirect operator.
[*.sh]
binary_next_line = true
simplify = true
space_redirects = true
switch_case_indent = true

[.githooks/*]
binary_next_line = true
simplify = true
space_redirects = true
switch_case_indent = true
